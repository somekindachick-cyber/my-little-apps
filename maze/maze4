    <div id="canvasContainer">
        <canvas id="mazeCanvas" width="600" height="600"></canvas>
        <div id="victoryMessage" id="msg">🔱 圣殿重燃 🔱<br><span style="font-size:18px;color:#a89f91;">正在开启下一密境...</span></div>
